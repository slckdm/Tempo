# Backend targets used by the Vite dev proxy (see vite.config.ts).
# Override only if your services run somewhere other than the defaults.
MANAGEMENT_URL=http://127.0.0.1:8001
STREAMING_URL=http://127.0.0.1:8002
METADATA_URL=http://127.0.0.1:8003
LIBRARY_URL=http://127.0.0.1:8004
KEYCLOAK_URL=http://127.0.0.1:8080

# Browser-facing settings for Keycloak and Google identity brokering.
# GOOGLE_OAUTH_CLIENT_SECRET belongs in Keycloak, never in a VITE_* variable.
VITE_KEYCLOAK_PUBLIC_URL=http://localhost:8080
VITE_KEYCLOAK_GOOGLE_IDP_ALIAS=google

# Keycloak realm/client used for password and authorization-code login flows.
# These match management/.env and streaming/.env out of the box.
VITE_KEYCLOAK_REALM=realm
VITE_KEYCLOAK_CLIENT_ID=id
VITE_KEYCLOAK_CLIENT_SECRET=random
