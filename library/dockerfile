
FROM python:3.14-slim AS base

RUN pip install uv==0.11.2

ENV PATH="/app/.venv/bin:${PATH}"

WORKDIR /app
COPY ./pyproject.toml.local-docker /app/pyproject.toml
COPY alembic.ini /app/
COPY ./src /app

RUN uv lock && uv sync --frozen --group local_pypi
# RUN alembic upgrade head


FROM base AS backend

ENTRYPOINT python -m app.main.start

FROM base AS consumer

ENTRYPOINT python -m app.main.consumer
