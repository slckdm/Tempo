[project]
name = "management"
version = "0.1.0"
description = "Add your description here"
readme = "README.md"
requires-python = ">=3.14"
dependencies = [
    "pydantic (>=2.13.4,<3.0.0)",
    "uvicorn (>=0.49.0,<0.50.0)",
    "python-dotenv (>=1.2.2,<2.0.0)",
    "fastapi (>=0.136.3,<0.137.0)",
    "sqlalchemy (>=2.0.50,<3.0.0)",
    "alembic (>=1.18.4,<2.0.0)",
    "asyncpg (>=0.31.0,<0.32.0)",
    "greenlet (>=3.5.1,<4.0.0)",
    "dishka (>=1.10.1,<2.0.0)",
    "pydantic-settings (>=2.14.1,<3.0.0)",
    "pytest (>=9.1.0,<10.0.0)",
    "pytest-asyncio (>=1.4.0,<2.0.0)",
    "faker (>=40.23.0,<41.0.0)",
    "faststream[rabbit] (>=0.7.1,<0.8.0)",
    "dishka-faststream (>=0.7.0,<0.8.0)",
    "redis (>=8.0.1,<9.0.0)",
    "freezegun (>=1.5.5,<2.0.0)",
]

[tool.uv.sources]
toolkit = { url = "http://localhost:1010/packages/toolkit-0.1.3-py3-none-any.whl" }

[dependency-groups]
local_pypi = ["toolkit"]

[tool.pytest.ini_options]
pythonpath = ["src"]
testpaths = ["tests"]
asyncio_mode = "auto"
