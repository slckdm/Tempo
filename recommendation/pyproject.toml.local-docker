[project]
name = "recommendation"
version = "0.1.0"
description = "Add your description here"
readme = "README.md"
requires-python = ">=3.14"
dependencies = [
    "alembic>=1.19.1",
    "datasets>=5.0.1",
    "dishka-faststream>=0.7.0",
    "faststream>=0.7.5",
    "greenlet>=3.5.5",
    "librosa>=1.0.0",
    "pandas>=3.0.5",
    "qdrant-client>=1.19.0",
    "uvicorn>=0.52.4",
]

[tool.uv.sources]
tempo-toolkit-contracts = { url = "http://localhost:1010/packages/tempo_toolkit_contracts-0.2.21-py3-none-any.whl" }
tempo-toolkit-application = { url = "http://localhost:1010/packages/tempo_toolkit_application-0.2.21-py3-none-any.whl" }
tempo-toolkit-infrastructure = { url = "http://localhost:1010/packages/tempo_toolkit_infrastructure-0.2.21-py3-none-any.whl" }

[dependency-groups]
local_pypi = [
    "tempo-toolkit-contracts",
    "tempo-toolkit-application",
    "tempo-toolkit-infrastructure[web,keycloak,postgres,redis,s3,rabbitmq]",
]

[tool.pytest.ini_options]
pythonpath = ["src"]
testpaths = ["tests"]
asyncio_mode = "auto"
