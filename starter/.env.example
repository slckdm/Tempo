# Copy to .env and adjust. docker compose reads .env automatically.

# --- PostgreSQL superuser (admin) ---
POSTGRES_USER=root
POSTGRES_PASSWORD=rootpass
POSTGRES_DB=postgres

# --- Per-service databases ---
# Comma-separated entries of  dbname:user:password
# Each service gets its own database + dedicated login role that owns it.
# Keycloak needs its own DB here too — it stores realms/users/clients in Postgres.
POSTGRES_MULTIPLE_DATABASES=management:mgmt:mgmtpass,keycloak:keycloak:keycloakpass

# --- Keycloak (identity provider / auth server) ---
# Bootstrap admin for the Keycloak master realm console (http://localhost:8080).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# DB Keycloak connects to (must match an entry in POSTGRES_MULTIPLE_DATABASES).
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloakpass
