[project]
name = "streaming"
version = "0.1.0"
description = "Add your description here"
readme = "README.md"
requires-python = ">=3.14"
dependencies = [
    "uvicorn (>=0.49.0,<0.50.0)",
    "python-dotenv (>=1.2.2,<2.0.0)",
    "dishka (>=1.10.1,<2.0.0)",
    "pytest (>=9.1.0,<10.0.0)",
    "pytest-asyncio (>=1.4.0,<2.0.0)",
    "faker (>=40.23.0,<41.0.0)"
]

[tool.uv.sources]
tempo-toolkit-contracts = { url = "http://localhost:1010/packages/tempo_toolkit_contracts-0.2.1-py3-none-any.whl" }
tempo-toolkit-application = { url = "http://localhost:1010/packages/tempo_toolkit_application-0.2.1-py3-none-any.whl" }
tempo-toolkit-infrastructure = { url = "http://localhost:1010/packages/tempo_toolkit_infrastructure-0.2.1-py3-none-any.whl" }

[dependency-groups]
local_pypi = [
    "tempo-toolkit-contracts",
    "tempo-toolkit-application",
    "tempo-toolkit-infrastructure[web,keycloak,redis,s3]",
]

[tool.pytest.ini_options]
pythonpath = ["src"]
testpaths = ["tests"]
asyncio_mode = "auto"
